# Copy this file to lab.env (same folder) and change the IPs to match YOUR lab:
#   cp lab.env.example lab.env && nano lab.env
# lab.env is git-ignored, so your real addresses never get committed.
#
# These defaults are the placeholder plan from setup-plan.md. Find your real
# ones with `ip -br addr` (Linux) or `ipconfig` (Windows).

LAB_SUBNET="192.168.50.0/24"
WAZUH_IP="192.168.50.10"
WIN_IP="192.168.50.20"
LINUX_IP="192.168.50.30"

# Test account the SSH failed-login exercise aims at (created by setup-linux-srv.sh).
LAB_SSH_USER="labuser"
